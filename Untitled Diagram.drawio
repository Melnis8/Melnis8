        <mxCell id="6T2IUSXusNaJ_9yaOt2v-2" value="&lt;p class=&quot;MsoNormal&quot;&gt;&lt;span style=&quot;mso-spacerun:&#39;yes&#39;;font-family:&#39;Times New Roman&#39;;mso-fareast-font-family:仿宋_GB2312;&lt;br/&gt;mso-ansi-font-weight:normal;mso-bidi-font-weight:bold;font-size:14.0000pt;&lt;br/&gt;mso-font-kerning:1.0000pt;&quot;&gt;&lt;font face=&quot;仿宋_GB2312&quot;&gt;提供结构化医学知识&lt;/font&gt;&lt;font face=&quot;仿宋_GB2312&quot;&gt;，增强模型的决策能力，使其不仅能提供诊断，还能给出医学依据。&lt;/font&gt;&lt;/span&gt;&lt;/p&gt;" style="text;whiteSpace=wrap;html=1;strokeColor=default;dashed=1;" vertex="1" parent="LsPmRJd33uCZ10RQm79f-6">
